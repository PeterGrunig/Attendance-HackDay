INTEGRATION_CREDENTIAL_KEY=w87wEsglrFh0ofHc0DPwbtF0c8DPGZfnpqiurgBQnc4=

# Optional dormant Canvas adapter settings. Not used by current placeholders.
# If re-enabled, the redirect URL must exactly match the Canvas Developer Key.
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URL=http://localhost:4000/integrations/canvas/callback

# Optional classroom-prize email delivery. Leave SMTP_HOST or SMTP_FROM blank
# to keep the durable outbox pending without attempting delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REQUIRE_TLS=true
