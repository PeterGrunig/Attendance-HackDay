# Local development defaults. Copy this file to .env before running the app.
POSTGRES_PASSWORD=yoursupersecratpassword
DATABASE_URL=postgres://attendance:yoursupersecratpassword@localhost:5433/attendancehackday?sslmode=disable

# Generate a base64-encoded 32-byte key and keep it stable after connections exist.
INTEGRATION_CREDENTIAL_KEY=

# Canvas OAuth developer-key settings. The redirect URL must exactly match Canvas.
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URL=http://localhost:4000/admin/integrations/canvas/callback

